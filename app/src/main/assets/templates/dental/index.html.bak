<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dental Health - Quality Healthcare</title>
  <meta name="description" content="Professional dental services matching current technologies — Trusted Dentist in West New York.">

  <!-- Fonts: Open Sauce One -->
  <link href="https://db.onlinewebfonts.com/c/1cd1e7d71e048159076fd90b39846902?family=Open+Sauce+One" rel="stylesheet">
  <link href="https://db.onlinewebfonts.com/c/42acf9aa4a6dc2f2886a3f682e337ead?family=Open+Sauce+One+Bold" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html, body, #root {
      height: 100%;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Open Sauce One', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background-color: #ffffff;
      color: #000000;
    }

    /* Staggered Reveal Transitions */
    .reveal-item {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Mobile Hamburger Animation */
    .burger-span {
      transition: all 0.3s cubic-bezier(0.76, 0, 0.24, 1);
    }
  </style>
</head>
<body class="bg-white">

  <!-- =========================================================================
       SPLASH SCREEN (0 -> 100 over 2000ms at Bottom-Left)
       ========================================================================= -->
  <div id="splash-screen" class="fixed inset-0 z-[100] bg-white flex items-end justify-start transition-opacity duration-700">
    <div id="splash-counter" class="text-7xl md:text-9xl font-bold tabular-nums p-6 md:p-10 leading-none text-black select-none">
      0
    </div>
  </div>

  <!-- =========================================================================
       NAVBAR (Fixed Top)
       ========================================================================= -->
  <nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-4 md:px-6 py-2 md:py-3 bg-white/80 backdrop-blur-md">
    
    <!-- Logo (Left Side) -->
    <a href="#" class="flex flex-col select-none">
      <span class="text-xl md:text-2xl font-extrabold uppercase tracking-tight leading-none">Dental</span>
      <span class="text-xl md:text-2xl font-extrabold uppercase tracking-tight leading-none -mt-1.5 md:-mt-2">Health</span>
      <span class="text-[8px] md:text-[9px] font-medium leading-none mt-1.5 md:mt-2 text-neutral-600">quality healthcare</span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-6">
      <button onclick="toggleMobileMenu()" class="px-6 py-3 bg-white rounded-full border border-black text-sm font-semibold hover:bg-black hover:text-white transition-colors duration-200 cursor-pointer">
        Menu
      </button>
      <span class="text-sm font-semibold text-black">Dental Emergency</span>
    </div>

    <!-- Mobile Hamburger Button -->
    <button id="mobile-burger-btn" onclick="toggleMobileMenu()" class="md:hidden w-10 h-10 flex items-center justify-center relative cursor-pointer" aria-label="Toggle Navigation">
      <span id="burger-top" class="burger-span absolute h-0.5 w-6 bg-black rounded-full -translate-y-2"></span>
      <span id="burger-mid" class="burger-span absolute h-0.5 w-6 bg-black rounded-full opacity-100 scale-x-100"></span>
      <span id="burger-bot" class="burger-span absolute h-0.5 w-6 bg-black rounded-full translate-y-2"></span>
    </button>

  </nav>

  <!-- =========================================================================
       MOBILE MENU DRAWER OVERLAY
       ========================================================================= -->
  <div id="mobile-menu-overlay" class="md:hidden fixed inset-0 z-40 pointer-events-none transition-all duration-500">
    <!-- Backdrop -->
    <div id="menu-backdrop" onclick="toggleMobileMenu()" class="absolute inset-0 bg-black/20 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    
    <!-- Slide-in Panel -->
    <div id="menu-panel" class="absolute top-0 right-0 h-full w-[85%] max-w-sm bg-white shadow-2xl translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] flex flex-col justify-center px-8 gap-1">
      <div class="flex flex-col gap-4 my-auto">
        <a href="#section-1" onclick="toggleMobileMenu()" class="text-4xl font-bold text-black hover:text-neutral-500 transition-colors">Home</a>
        <a href="#section-2" onclick="toggleMobileMenu()" class="text-4xl font-bold text-black hover:text-neutral-500 transition-colors">Services</a>
        <a href="#section-3" onclick="toggleMobileMenu()" class="text-4xl font-bold text-black hover:text-neutral-500 transition-colors">About</a>
        <a href="#section-2" onclick="toggleMobileMenu()" class="text-4xl font-bold text-black hover:text-neutral-500 transition-colors">Gallery</a>
        <a href="#section-3" onclick="toggleMobileMenu()" class="text-4xl font-bold text-black hover:text-neutral-500 transition-colors">Contact</a>
      </div>

      <div class="mt-8 pt-8 border-t border-neutral-200">
        <div class="text-sm font-semibold text-black mb-4">Dental Emergency</div>
        <button onclick="alert('Appointment booking system initialized.'); toggleMobileMenu();" class="w-full px-6 py-4 bg-black rounded-full text-white text-sm font-semibold hover:bg-neutral-800 transition-colors duration-200 cursor-pointer">
          Book Appointment
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       SECTION 1: HERO (Masked Cards Technique)
       ========================================================================= -->
  <section id="section-1" class="relative h-screen w-full overflow-hidden flex flex-col pt-24 md:pt-24 px-3 md:px-5 pb-1.5 md:pb-2 gap-1.5 md:gap-2">
    
    <!-- 3 Feature Bars -->
    <div class="reveal-item w-full h-14 md:h-20 shrink-0 rounded-xl md:rounded-2xl overflow-hidden relative shadow-sm"
         style="background-image: url('https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260624_113640_ccf3cf97-d447-425b-a134-d7b09fc743fc.png&w=1280&q=85'); background-size: cover; background-position: center 10%;">
      <span class="flex items-center justify-center h-full text-black text-lg md:text-3xl font-bold text-center relative z-10 bg-white/40 backdrop-blur-xs">
        Advanced Dentistry
      </span>
    </div>

    <div class="reveal-item w-full h-14 md:h-20 shrink-0 rounded-xl md:rounded-2xl overflow-hidden relative shadow-sm"
         style="background-image: url('https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260624_113640_ccf3cf97-d447-425b-a134-d7b09fc743fc.png&w=1280&q=85'); background-size: cover; background-position: center 25%;">
      <span class="flex items-center justify-center h-full text-black text-lg md:text-3xl font-bold text-center relative z-10 bg-white/40 backdrop-blur-xs">
