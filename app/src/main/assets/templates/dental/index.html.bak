           style="background-image: url('https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260624_114219_414dfe80-f15c-4e25-bf52-b13721f4bd88.png&w=1280&q=85'); background-size: cover; background-position: center bottom;">
        <div class="absolute inset-0 z-10 flex flex-wrap md:flex-nowrap gap-1.5 md:gap-2 p-2 md:p-3">
          
          <!-- Service 1 (Active) -->
          <div class="flex-1 min-w-[calc(50%-4px)] md:min-w-0 rounded-xl md:rounded-2xl p-3 md:p-5 flex flex-col justify-between bg-white/90 backdrop-blur-md shadow-sm">
            <h3 class="text-xl md:text-4xl font-bold leading-[1.05] text-black">Dental<br>Veneers</h3>
            <span class="self-end w-8 h-8 md:w-12 md:h-12 rounded-full border border-black text-black flex items-center justify-center text-xs md:text-sm font-semibold">01</span>
          </div>

          <!-- Service 2 -->
          <div class="flex-1 min-w-[calc(50%-4px)] md:min-w-0 rounded-xl md:rounded-2xl p-3 md:p-5 flex flex-col justify-between bg-white/20 backdrop-blur-xl">
            <h3 class="text-xl md:text-4xl font-bold leading-[1.05] text-white">Dental<br>Crowns</h3>
            <span class="self-end w-8 h-8 md:w-12 md:h-12 rounded-full border border-white text-white flex items-center justify-center text-xs md:text-sm font-semibold">02</span>
          </div>

          <!-- Service 3 -->
          <div class="flex-1 min-w-[calc(50%-4px)] md:min-w-0 rounded-xl md:rounded-2xl p-3 md:p-5 flex flex-col justify-between bg-white/20 backdrop-blur-xl">
            <h3 class="text-xl md:text-4xl font-bold leading-[1.05] text-white">Teeth<br>Whitening</h3>
            <span class="self-end w-8 h-8 md:w-12 md:h-12 rounded-full border border-white text-white flex items-center justify-center text-xs md:text-sm font-semibold">03</span>
          </div>

          <!-- Service 4 -->
          <div class="flex-1 min-w-[calc(50%-4px)] md:min-w-0 rounded-xl md:rounded-2xl p-3 md:p-5 flex flex-col justify-between bg-white/20 backdrop-blur-xl">
            <h3 class="text-xl md:text-4xl font-bold leading-[1.05] text-white">Dental<br>Implants</h3>
