  <!-- =========================================================================
       SECTION 3: IMPLANT DENTISTRY
       ========================================================================= -->
  <section id="section-3" class="relative min-h-screen md:h-screen w-full overflow-hidden flex flex-col pt-1.5 md:pt-2 px-3 md:px-5 pb-1.5 md:pb-2 gap-1.5 md:gap-2">
    
    <div class="flex-1 min-h-0 grid grid-cols-1 md:grid-cols-2 gap-1.5 md:gap-2">
      
      <!-- LEFT COLUMN -->
      <div class="flex flex-col gap-1.5 md:gap-2">
        
        <!-- 1. Heading Card -->
        <div class="reveal-item rounded-xl md:rounded-2xl bg-stone-50 p-5 md:p-7 flex flex-col justify-between flex-[1.2] min-h-[180px] md:min-h-0 shadow-sm">
          <h2 class="text-[clamp(3rem,7vw,6.5rem)] font-bold leading-[0.95] text-black">
            Implant<br>Dentistry
          </h2>
