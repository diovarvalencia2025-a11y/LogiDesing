          <div class="flex-1 rounded-xl md:rounded-2xl overflow-hidden shadow-sm">
            <img src="https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260624_115253_c19ab167-8dd5-48b4-967d-b9f0d9d6e8fb.png&w=1280&q=85" alt="Dental implant procedure" class="w-full h-full object-cover">
          </div>
          <div class="flex-1 rounded-xl md:rounded-2xl overflow-hidden shadow-sm">
            <img src="https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260624_115237_fc519057-6e87-4abf-999a-9610b8b085b4.png&w=1280&q=85" alt="Dental restoration" class="w-full h-full object-cover">
          </div>
        </div>

        <!-- 3. Consultation Card -->
        <div class="reveal-item rounded-xl md:rounded-2xl bg-zinc-200 p-5 md:p-7 flex items-end justify-between flex-[0.8] min-h-[160px] md:min-h-0 shadow-sm">
          <div>
            <p class="text-xs md:text-sm font-semibold text-black mb-2 md:mb-3">Consultation</p>
            <h3 class="text-xl md:text-3xl font-bold text-black leading-6 md:leading-8">
              Dental<br>Restoration<br>Services
            </h3>
          </div>
          <button onclick="alert('Booking online consultation...');" class="px-5 py-3 md:px-8 md:py-5 bg-white rounded-full text-black text-base md:text-xl font-bold hover:scale-105 transition-transform cursor-pointer shadow-md">
            Book Online
          </button>
        </div>

      </div>

      <!-- RIGHT COLUMN: Single Tall Image Card -->
      <div class="reveal-item rounded-xl md:rounded-2xl overflow-hidden relative min-h-[350px] md:min-h-0 shadow-md">
        <img src="https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260624_114355_752ba9e6-0942-4abb-9047-5d9bb16632e9.png&w=1280&q=85" alt="Smiling patient" class="w-full h-full object-cover">
        
        <!-- Bottom Overlay Cards -->
        <div class="absolute bottom-3 left-3 right-3 md:bottom-5 md:left-5 md:right-5 flex gap-1.5 md:gap-2">
          
          <!-- Overlay 1: White Card -->
          <div class="flex-1 bg-white rounded-xl md:rounded-2xl p-3 md:p-5 flex flex-col justify-between h-36 md:h-52 shadow-md">
            <h4 class="text-lg md:text-2xl font-bold text-black leading-5 md:leading-7">
              The Process<br>of Installing<br>Implants
            </h4>
            <div class="self-end w-9 h-9 md:w-12 md:h-12 rounded-full border border-black flex items-center justify-center cursor-pointer hover:bg-black hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="rotate-[-45deg]">
                <path d="M1 7h12m0 0L8 2m5 5L8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <!-- Overlay 2: Glass Card -->
          <div class="flex-1 bg-white/20 backdrop-blur-xl rounded-xl md:rounded-2xl p-3 md:p-5 flex flex-col justify-between h-36 md:h-52 shadow-md">
            <h4 class="text-lg md:text-2xl font-bold text-white leading-5 md:leading-7">
              Caring<br>for Dental<br>Implants
            </h4>
            <div class="self-end w-9 h-9 md:w-12 md:h-12 rounded-full border border-white text-white flex items-center justify-center cursor-pointer hover:bg-white hover:text-black transition-colors">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="rotate-[-45deg]">
                <path d="M1 7h12m0 0L8 2m5 5L8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- =========================================================================
       SCRIPTS: SPLASH SCREEN, INTERSECTION OBSERVER, & MENU
       ========================================================================= -->
  <script>
    // 1. Splash Screen 0 -> 100 Counter
    const splashScreen = document.getElementById('splash-screen');
    const splashCounter = document.getElementById('splash-counter');
    let count = 0;

    const countInterval = setInterval(() => {
      count++;
      splashCounter.innerText = count;
      if (count >= 100) {
        clearInterval(countInterval);
        setTimeout(() => {
          splashScreen.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => {
            splashScreen.remove();
          }, 700);
        }, 200);
      }
    }, 20); // 20ms * 100 = 2000ms

    // 2. IntersectionObserver Staggered Reveal Animation
    const revealItems = document.querySelectorAll('.reveal-item');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.15 });

    revealItems.forEach(item => observer.observe(item));

    // 3. Mobile Menu Toggle
    let isMenuOpen = false;
    const overlay = document.getElementById('mobile-menu-overlay');
    const backdrop = document.getElementById('menu-backdrop');
    const panel = document.getElementById('menu-panel');
    const bTop = document.getElementById('burger-top');
    const bMid = document.getElementById('burger-mid');
    const bBot = document.getElementById('burger-bot');

    function toggleMobileMenu() {
      isMenuOpen = !isMenuOpen;
      document.body.style.overflow = isMenuOpen ? 'hidden' : '';

      if (isMenuOpen) {
        overlay.classList.remove('pointer-events-none');
        overlay.classList.add('pointer-events-auto');
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-x-full');
        panel.classList.add('translate-x-0');

        bTop.classList.remove('-translate-y-2');
        bTop.classList.add('rotate-45', 'translate-y-0');
        bMid.classList.remove('opacity-100', 'scale-x-100');
        bMid.classList.add('opacity-0', 'scale-x-0');
        bBot.classList.remove('translate-y-2');
        bBot.classList.add('-rotate-45', 'translate-y-0');
      } else {
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        panel.classList.remove('translate-x-0');
        panel.classList.add('translate-x-full');

        bTop.classList.remove('rotate-45', 'translate-y-0');
        bTop.classList.add('-translate-y-2');
        bMid.classList.remove('opacity-0', 'scale-x-0');
        bMid.classList.add('opacity-100', 'scale-x-100');
        bBot.classList.remove('-rotate-45', 'translate-y-0');
        bBot.classList.add('translate-y-2');

        setTimeout(() => {
          if (!isMenuOpen) {
            overlay.classList.remove('pointer-events-auto');
            overlay.classList.add('pointer-events-none');
          }
        }, 500);
      }
    }
  </script>
</body>
</html>
