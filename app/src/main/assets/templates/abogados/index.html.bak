        <div>
          <div class="inline-flex items-center gap-2 mb-2">
            <span class="w-5 h-[2px] bg-gold-600"></span>
            <span class="text-xs font-bold tracking-[0.2em] text-gold-700 uppercase">
              NUESTRAS ESPECIALIDADES
            </span>
          </div>
          <h2 class="font-serif-lux text-4xl sm:text-5xl text-slate-900 font-semibold tracking-tight">
