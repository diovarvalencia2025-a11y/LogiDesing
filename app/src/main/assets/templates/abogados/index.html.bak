      <button onclick="closeModal('consultaModal')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <h3 class="font-serif-lux text-2xl font-bold text-slate-900 mb-1">Primera Consulta Gratuita</h3>
      <p class="text-xs text-slate-500 mb-5">Indique sus datos y le responderemos con prioridad bajo secreto profesional.</p>
      <form onsubmit="handleQuickSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Nombre Completo *</label>
          <input type="text" required placeholder="Su nombre" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm outline-none focus:border-gold-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Teléfono *</label>
          <input type="tel" required placeholder="600 000 000" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm outline-none focus:border-gold-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Área o Asunto *</label>
          <input type="text" id="modalServiceInput" required placeholder="Ej. Tarjeta revolving, Divorcio, Herencia..." class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm outline-none focus:border-gold-500">
        </div>
        <button type="submit" class="w-full py-3 rounded-lg bg-gold-500 hover:bg-gold-600 text-slate-950 font-bold text-sm shadow">
          Solicitar Cita Gratuita
        </button>
      </form>
    </div>
  </div>

  <div id="avisoModal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-4">
