            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-sm p-1.5 rounded-md text-gold-700 shadow">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif-lux text-xl font-bold text-slate-900 mb-3 leading-snug">
                Derecho Bancario y Financiero
              </h3>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-600">
                <li class="flex items-start gap-2">
                  <span class="text-gold-600 font-bold">•</span>
