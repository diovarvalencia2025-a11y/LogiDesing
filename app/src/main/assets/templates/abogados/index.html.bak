  <!-- 2. HERO SECTION CON FONDO DE CATEDRAL DE BURGOS -->
  <section id="inicio" class="relative hero-container min-h-[580px] lg:min-h-[640px] flex items-center py-16 lg:py-24 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Columna Izquierda: Texto Principal -->
        <div class="lg:col-span-8 z-10 max-w-2xl">
          
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <div class="inline-flex items-center gap-2">
              <span class="w-6 h-[1.5px] bg-gold-500"></span>
              <span class="text-xs sm:text-sm font-semibold tracking-[0.25em] text-gold-400 uppercase">
                TU CONFIANZA, MI COMPROMISO
              </span>
            </div>
            <span class="text-slate-600 hidden sm:inline">•</span>
            <span class="font-serif-lux italic text-xs sm:text-sm text-gold-300/90 tracking-wide">
