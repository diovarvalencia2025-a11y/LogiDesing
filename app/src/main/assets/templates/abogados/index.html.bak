  <style>
    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: #0e1218;
      color: #1a202c;
      overflow-x: hidden;
    }

    .font-serif-lux {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }

    .font-title-lux {
      font-family: 'Cinzel', serif;
    }

    .font-signature {
      font-family: 'Alex Brush', cursive;
    }

    .hero-container {
      background-color: #0e1218;
      background-image: 
        linear-gradient(to right, rgba(14, 18, 24, 0.96) 0%, rgba(14, 18, 24, 0.88) 42%, rgba(14, 18, 24, 0.35) 75%, rgba(14, 18, 24, 0.15) 100%),
        url('assets/bg-hero.png');
      background-position: right center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    @media (max-width: 768px) {
      .hero-container {
        background-image: 
          linear-gradient(to bottom, rgba(14, 18, 24, 0.94) 0%, rgba(14, 18, 24, 0.97) 100%),
          url('assets/bg-hero.png');
      }
    }

    .experience-container {
      background-color: #0c1017;
      background-image: 
        linear-gradient(to right, rgba(12, 16, 23, 0.85) 0%, rgba(12, 16, 23, 0.45) 45%, rgba(12, 16, 23, 0.6) 80%, rgba(12, 16, 23, 0.92) 100%),
        url('assets/bg-experience.png');
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .footer-container {
      background-color: #0b0e13;
      background-image: 
        linear-gradient(to bottom, rgba(11, 14, 19, 0.85) 0%, rgba(11, 14, 19, 0.70) 45%, rgba(11, 14, 19, 0.95) 100%),
        url('assets/footer-panorama.jpg');
      background-position: center bottom;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .card-hover {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.08), 0 10px 15px -5px rgba(197, 160, 89, 0.15);
      border-color: #c5a059;
    }

    .modal-backdrop {
      background-color: rgba(10, 14, 20, 0.82);
      backdrop-filter: blur(6px);
    }
  </style>
</head>
<body class="antialiased selection:bg-gold-500 selection:text-white">

