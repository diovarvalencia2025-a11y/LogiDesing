      <!-- Formulario de Primera Consulta Gratuita -->
      <div id="consulta-form" class="bg-white rounded-2xl p-8 sm:p-12 border border-[#e8e4dc] shadow-xl max-w-3xl mx-auto">
        <div class="text-center max-w-xl mx-auto mb-8">
          <div class="inline-flex items-center gap-2 mb-2">
            <span class="w-4 h-[2px] bg-gold-600"></span>
            <span class="text-xs font-bold tracking-widest text-gold-700 uppercase">SIN COSTE NI COMPROMISO</span>
            <span class="w-4 h-[2px] bg-gold-600"></span>
          </div>
          <h3 class="font-serif-lux text-3xl sm:text-4xl font-bold text-slate-900">
            Solicite su Primera Consulta Gratuita
          </h3>
          <p class="text-slate-600 text-sm mt-2">
            Expónganos brevemente su situación. Analizaremos su caso de manera confidencial y nos pondremos en contacto con usted a la mayor brevedad.
          </p>
        </div>

        <form id="contactForm" onsubmit="handleFormSubmit(event)" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Nombre y Apellidos *</label>
              <input type="text" id="formName" required placeholder="Ej. Carlos Martínez" class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Teléfono de Contacto *</label>
              <input type="tel" id="formPhone" required placeholder="Ej. 600 000 000" class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
              <input type="email" id="formEmail" placeholder="su-correo@ejemplo.com" class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Área de Consulta *</label>
              <select id="formArea" required class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition bg-white">
                <option value="" disabled selected>Seleccione la especialidad...</option>
                <option value="Derecho Bancario y Financiero">Derecho Bancario (Cláusulas, Revolving)</option>
                <option value="Derecho de Familia">Derecho de Familia (Divorcios, Custodias)</option>
                <option value="Derecho Civil y Sucesorio">Derecho Civil y Sucesorio (Herencias)</option>
                <option value="Derecho Penal y Laboral">Derecho Penal y Laboral</option>
                <option value="Otra Consulta Legal">Otra consulta legal</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Resumen breve de su caso *</label>
            <textarea id="formMessage" required rows="3" placeholder="Explique brevemente en qué podemos ayudarle..." class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition resize-none"></textarea>
          </div>

          <div class="flex items-start gap-3 pt-1">
            <input type="checkbox" id="rgpdCheck" required class="mt-1 rounded border-slate-300 text-gold-600 focus:ring-gold-500 h-4 w-4">
            <label for="rgpdCheck" class="text-xs text-slate-600 leading-normal">
              He leído y acepto la <button type="button" onclick="openModal('privacidadModal')" class="text-gold-700 underline font-medium">Política de Privacidad</button> y consiento el tratamiento de mis datos para la gestión de mi consulta legal bajo estricto secreto profesional.
            </label>
          </div>

          <button type="submit" class="w-full py-4 rounded-lg bg-[#c5a059] hover:bg-[#d4af37] text-slate-950 font-semibold text-base shadow-lg transition-all transform hover:-translate-y-0.5">
            Solicitar Cita / Enviar Consulta Gratuita →
          </button>
        </form>

        <div id="formSuccess" class="hidden mt-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-center text-sm">
          <p class="font-bold text-base mb-1">✓ Su consulta ha sido registrada con éxito</p>
          <p class="text-emerald-700 text-xs">Le responderemos a la mayor brevedad al teléfono indicado bajo estricta confidencialidad.</p>
        </div>

