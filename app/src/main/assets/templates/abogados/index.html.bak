        <!-- Tarjeta 3: Derecho Civil y Sucesorio -->
        <div class="bg-white rounded-xl overflow-hidden border border-[#e8e4dc] shadow-sm card-hover flex flex-col">
          <div class="relative h-44 overflow-hidden bg-slate-100">
