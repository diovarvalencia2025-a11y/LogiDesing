                <span>Consultar este servicio</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Tarjeta 2: Derecho de Familia -->
        <div class="bg-white rounded-xl overflow-hidden border border-[#e8e4dc] shadow-sm card-hover flex flex-col">
          <div class="relative h-44 overflow-hidden bg-slate-100">
            <img src="assets/card-familia.jpg" alt="Derecho de Familia en Burgos" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-sm p-1.5 rounded-md text-gold-700 shadow">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
