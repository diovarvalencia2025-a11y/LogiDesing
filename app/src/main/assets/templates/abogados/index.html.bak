      <div class="text-xs sm:text-sm text-slate-600 space-y-3 leading-relaxed">
        <p>El secreto profesional es un pilar fundamental del Estado de Derecho y un derecho de los ciudadanos consagrado en el artículo 542.3 de la Ley Orgánica del Poder Judicial (LOPJ).</p>
        <p>Toda comunicación, documentación, consulta preliminar o dato compartido con el <strong>Bufete Anastasia Payno</strong> está blindado bajo el más riguroso deber y derecho de secreto profesional de la Abogacía Española.</p>
      </div>
    </div>
  </div>

  <script>
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    function openModalWithService(serviceName) {
      document.getElementById('modalServiceInput').value = serviceName;
      openModal('consultaModal');
    }

    window.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal-backdrop')) {
        e.target.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }
    });

    function handleFormSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('formName').value;
      const phone = document.getElementById('formPhone').value;
      const area = document.getElementById('formArea').value;
      const msg = document.getElementById('formMessage').value;

      document.getElementById('contactForm').classList.add('hidden');
      document.getElementById('formSuccess').classList.remove('hidden');

      setTimeout(() => {
        const text = encodeURIComponent(`Hola Bufete Anastasia Payno. Mi nombre es ${name} (Tel: ${phone}). Quisiera una consulta sobre ${area}: "${msg}"`);
        window.open(`https://wa.me/34631122707?text=${text}`, '_blank');
      }, 1600);
    }

    function handleQuickSubmit(e) {
      e.preventDefault();
      closeModal('consultaModal');
      alert('¡Muchas gracias! Su solicitud ha sido registrada con éxito. Nos pondremos en contacto con usted en menos de 24 horas bajo estricto secreto profesional.');
    }
  </script>

