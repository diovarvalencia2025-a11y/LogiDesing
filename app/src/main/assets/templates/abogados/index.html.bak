  <!-- 3. SECCIÓN: ÁREAS DE PRÁCTICA (ESPECIALIDADES) -->
  <section id="especialidades" class="bg-[#f8f6f1] py-20 px-4 sm:px-6 lg:px-8 border-b border-[#e8e4dc]">
    <div class="max-w-7xl mx-auto">
      
