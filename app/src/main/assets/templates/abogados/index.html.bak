            <button onclick="openModal('consultaModal')" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-md bg-[#c5a059] hover:bg-[#d4af37] text-slate-950 font-medium text-base shadow-xl shadow-gold-500/10 transition-all hover:scale-[1.02] active:scale-[0.98]">
              <span>Primera consulta gratuita</span>
              <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <a href="tel:947023159" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 text-base font-medium transition">
