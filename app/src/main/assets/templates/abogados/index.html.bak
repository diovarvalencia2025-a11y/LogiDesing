<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bufete Anastasia Payno • Abogada en Burgos | Asesoramiento Jurídico y Defensa Legal</title>
  <meta name="description" content="Bufete Anastasia Payno en Burgos. Especialistas en Derecho Bancario, Familia, Herencias, Civil y Penal. Primera consulta gratuita. Calle Santander, 9.">
  <meta name="keywords" content="abogada burgos, bufete anastasia payno, clausulas suelo burgos, divorcios burgos, herencias burgos, abogado bancario burgos">
  <meta name="author" content="Bufete Anastasia Payno - LogiMotion Digital">
  
  <!-- Favicon Monograma AP -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230f141c'/><text x='50' y='68' font-family='Cinzel, serif' font-size='52' font-weight='bold' fill='%23c5a059' text-anchor='middle'>AP</text></svg>">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold: {
              300: '#e0c88a',
              400: '#d4af37',
              500: '#c5a059',
              600: '#a8833e',
              700: '#8a692b'
            },
            legal: {
              dark: '#0e1218',
              surface: '#141a23',
              card: '#1a222e',
              cream: '#f8f6f1',
              creamSoft: '#fbfaf7',
              border: '#e8e4dc',
              textMuted: '#6b7280'
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            title: ['"Cinzel"', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            handwriting: ['"Alex Brush"', 'cursive']
          }
        }
      }
