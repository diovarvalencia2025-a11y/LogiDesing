<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <!-- Icono de mensaje de chat -->
    <ImageView
        android:id="@+id/ivChatIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/desc_message_icon"
        android:src="@drawable/ic_chat_bubble"
        app:tint="#52525B" />

    <!-- Textos: Titulo de conversacion y fecha relativa -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConversationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#09090B"
            android:textSize="15sp"
            android:textStyle="normal"
            tools:text="Lavadora atascada con boton rojo" />

        <TextView
            android:id="@+id/tvConversationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#71717A"
            android:textSize="12sp"
            tools:text="Hace 2 horas" />
    </LinearLayout>

</LinearLayout>
